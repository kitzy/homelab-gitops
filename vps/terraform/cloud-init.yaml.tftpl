#cloud-config
# First-boot setup for ${hostname}. Rendered by Terraform (templatefile) and
# run once. Terraform ignores later changes to this file (ignore_changes on
# user_data), so edits only affect a newly created VM.
#
# Secrets: the only secret here is the single-use Tailscale key, which expires
# an hour after it is minted. The 1Password service account token for Doco-CD
# is added by hand after boot (see vps/README.md).

hostname: ${hostname}
timezone: Etc/UTC
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - jq
  - unattended-upgrades

write_files:
  # Log rotation for every container, so logs cannot fill the disk.
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        }
      }

  # Security updates only, applied daily. No automatic reboot: the databases
  # run here, so reboots stay manual.
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  - path: /etc/sysctl.d/90-swap.conf
    permissions: "0644"
    content: |
      vm.swappiness = 10

  # Doco-CD, the GitOps controller. It polls kitzy/homelab-gitops and deploys
  # the stacks listed in .doco-cd.yml. It cannot deploy itself, so it lives on
  # the host and is started by hand once the 1Password token is in place.
  - path: /opt/doco-cd/compose.yaml
    permissions: "0644"
    content: |
      services:
        doco-cd:
          image: ghcr.io/kimdre/doco-cd:0.134.0
          container_name: doco-cd
          restart: unless-stopped
          # Optional extra settings (e.g. APPRISE_NOTIFY_URLS). Mode 600.
          env_file: [.env]
          environment:
            TZ: America/New_York # job schedules in compose/backup use local time
            LOG_LEVEL: info
            # The repo is public, so no Git token is needed.
            POLL_CONFIG: |
              - url: https://github.com/kitzy/homelab-gitops.git
                reference: refs/heads/main
                interval: 180
            SECRET_PROVIDER: 1password
            SECRET_PROVIDER_ACCESS_TOKEN_FILE: /run/secrets/op_token
            # Each deploy resolves every secret in its stack. Caching keeps the
            # service account well under the 1Password rate limits.
            SECRET_PROVIDER_CACHE_ENABLED: "true"
            SECRET_PROVIDER_CACHE_TTL: 15m
          secrets: [op_token]
          volumes:
            - /var/run/docker.sock:/var/run/docker.sock
            - data:/data
          mem_limit: 256m
          healthcheck: # the image's built-in healthcheck command
            start_period: 30s
            interval: 30s
            timeout: 5s
            retries: 3
      secrets:
        op_token:
          file: ./op_token # 1Password service account token, mode 600
      volumes:
        data:

runcmd:
%{ if docker_on_volume ~}
  # Block storage for /var/lib/docker. Wait for it to attach, format it only
  # if it has no filesystem, and mount it before Docker is installed.
  - |
    set -eu
    dev=/dev/vdb
    for i in $(seq 1 60); do [ -b "$dev" ] && break; sleep 5; done
    [ -b "$dev" ] || { echo "block volume $dev never attached" >&2; exit 1; }
    blkid "$dev" >/dev/null 2>&1 || mkfs.ext4 -L docker "$dev"
    mkdir -p /var/lib/docker
    echo "UUID=$(blkid -s UUID -o value "$dev") /var/lib/docker ext4 defaults,nofail 0 2" >> /etc/fstab
    mount /var/lib/docker
%{ endif ~}
  # 4 GB swap. Real memory use is unmeasured, and the plan has no swap.
  - |
    set -eu
    if [ ! -f /swapfile ]; then
      fallocate -l 4G /swapfile
      chmod 600 /swapfile
      mkswap /swapfile
      echo "/swapfile none swap sw 0 0" >> /etc/fstab
    fi
    swapon -a
    sysctl --system >/dev/null

  # Docker Engine and the Compose plugin from Docker's apt repo.
  - |
    set -eu
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
    . /etc/os-release
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $${VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    systemctl enable --now docker

  # Tailscale from its apt repo. --accept-routes is needed to reach the
  # Synology (10.253.20.10) through the woolston-gateway subnet route.
  - |
    set -eu
    . /etc/os-release
    curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/$${VERSION_CODENAME}.noarmor.gpg" -o /usr/share/keyrings/tailscale-archive-keyring.gpg
    curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/$${VERSION_CODENAME}.tailscale-keyring.list" -o /etc/apt/sources.list.d/tailscale.list
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y tailscale
    systemctl enable --now tailscaled
    tailscale up --ssh --accept-routes --advertise-tags=tag:vps --hostname=${hostname} --auth-key=${tailscale_auth_key}

  # Admin access is Tailscale SSH, which does not use sshd. Turn sshd off so
  # nothing listens on the public interface even if the firewall is changed.
  - systemctl disable --now ssh.socket ssh.service

  # Shared network for cloudflared and the apps' HTTP services.
  - docker network inspect proxy >/dev/null 2>&1 || docker network create proxy

  # Doco-CD files. The token file is written by hand (see vps/README.md), and
  # Doco-CD is started after that.
  - install -m 600 /dev/null /opt/doco-cd/.env
